# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# PLATEAU SDK (手動管理)
/Packages/com.synesthesias.plateau-unity-sdk/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider
.idea/

# Visual Studio Code
.vscode/

# macOS
.DS_Store

# Build results
bin/
TestResults/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# ML-Agents timer logs
Assets/ML-Agents/Timers/namie_timers.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
llm_server/.env
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
mlagents-env/
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
llm_server/.venv/

# Conda
.conda/
conda-meta/
*.conda

# Jupyter Notebook
.ipynb_checkpoints

# PyCharm
.idea/

# pytest
.pytest_cache/
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ML-Agents training results (keep structure but ignore large files)
results/*/models/
results/*/*.onnx
results/*/*.pt
results/*/*.pth
results/*/checkpoint.pt
results/*/checkpoint.pth

# Miniconda installer
Miniconda3-*.sh

# PLATEAU SDK
Assets/StreamingAssets/.PLATEAU/

# Large Unity scene files (exceed GitHub 100MB limit)
Assets/Scenes/Iwaki.unity
Assets/Scenes/Iwaki.unity.meta
Assets/Scenes/Iwaki 1.unity
Assets/Scenes/Iwaki 1.unity.meta
Assets/Scenes/Iwaki1.unity
Assets/Scenes/Iwaki1.unity.meta
Assets/Scenes/Iwaki 2.unity
Assets/Scenes/Iwaki 2.unity.meta
Assets/Scenes/namie 1.unity
Assets/Scenes/namie 1.unity.meta
Assets/Scenes/namie.unity
Assets/Scenes/MInamiSoumaLOD2.unity
Assets/Scenes/MInamiSoumaLOD2.unity.meta

# Unity crash reports
mono_crash.*
*.crash

# Unity auto-generated project user files
*.csproj.user
*.sln.DotSettings

Paper.md
Paper.log
Paper.fls
Paper.fdb_latexmk
避難場所調査.md

# ML-Agents additional files
results/*/run_logs/
results/*/events.out.tfevents.*
results/*.onnx
results/*.pt

# ML-Agents training results (全体)
results/shelter_training/

# tmp directory
tmp/

# Backup files
*.backup

# Claude Code settings
.claude/

# HotReload package (サードパーティ、自動更新されるため管理外)
Packages/com.singularitygroup.hotreload/

# Python lock files (環境依存)
uv.lock

# traffic_server generated data
traffic_server/cache/
traffic_server/sumo_data/

# Backup files
*.bak

# SUMO output
*.tripinfo.xml
*.emission.xml

# Python version (個人環境依存)
.python-version

# Progress reports
progress_report_*.md

# Backup meta files
Assets/Config/personas.csv.bak.meta
